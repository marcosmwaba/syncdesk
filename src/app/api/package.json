{
  "name": "syncdesk-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply syncdesk-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply syncdesk-db --remote",
    "db:seed:local": "wrangler d1 execute syncdesk-db --local --file=seed/demo_users.sql",
    "db:seed:remote": "wrangler d1 execute syncdesk-db --remote --file=seed/demo_users.sql"
  },
  "dependencies": { "hono": "^4.6.0", "zod": "^3.23.8" },
  "devDependencies": { "@cloudflare/workers-types": "^5.20261118.1", "typescript": "^5.6.0", "wrangler": "^4.0.0" }
}
